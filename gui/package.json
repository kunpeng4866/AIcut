{
  "name": "aicut-desktop",
  "version": "0.1.0",
  "description": "AIcut - AI-powered video editor (Desktop)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:start": "node launch.js",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node launch.js\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0",
    "windows-shortcuts": "^0.1.6"
  },
  "build": {
    "appId": "com.aicut.desktop",
    "productName": "AIcut",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "../target/release/aicut-engine.exe",
        "to": "engine/aicut-engine.exe"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "../pack-staging/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "../pack-staging/python",
        "to": "python"
      },
      {
        "from": "../pack-staging/models",
        "to": "models"
      }
    ],
    "directories": {
      "output": "dist-full"
    },
    "asarUnpack": [
      "fonts/**",
      "engine/**"
    ]
  }
}
